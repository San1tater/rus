  $('#edName').oninput = (e)=>{ eq.name=e.target.value; scheduleSave(); renderEqList(); };
  $('#edType').onchange = (e)=>{ eq.type=e.target.value; applyAutoMount(eq); scheduleSave(); renderAll(); };
  $('#edLayer').onchange = (e)=>{ eq.layer=e.target.value; scheduleSave(); renderAll(); };
  $('#edBehind').onchange = (e)=>{ eq.behind=e.target.value==='1'; scheduleSave(); };
  $('#edScale').oninput = (e)=>{ eq.scale=parseInt(e.target.value,10)/100; $('#edScaleV').textContent=Math.round(eq.scale*100); scheduleSave(); };
  $('#edRot').oninput = (e)=>{ eq.rotation=parseInt(e.target.value,10)||0; $('#edRotV').textContent=eq.rotation; scheduleSave(); };
}

function applyAutoMount(eq){
  const cfg = EQ_TYPE_TO_LAYER[eq.type];
  if(!cfg) return;
  eq.layer = cfg.layer;
  eq.behind = cfg.behind;
  eq.scale = cfg.scale;
  eq.ox = cfg.ox || 0;
  eq.oy = cfg.oy || 0;
  eq.rotation = 0;
}

function bindCanvas(){
  const canvas = $('#canvas');
  let mode = null, dragLayer = null, dragEq = null, resizeCorner = null;
  let startCanvasX = 0, startCanvasY = 0, startState = null, lastMx = 0, lastMy = 0;

  function mousePos(e){
    const r = canvas.getBoundingClientRect();
    return { x:(e.clientX-r.left)*(canvas.width/r.width), y:(e.clientY-r.top)*(canvas.height/r.height) };
  }
  function hitCorner(layerId, mx, my){
    const tr = layerTransform(layerId);
    const corners = [{name:'nw',lx:0,ly:0},{name:'ne',lx:tr.w,ly:0},{name:'sw',lx:0,ly:tr.h},{name:'se',lx:tr.w,ly:tr.h}];
    for(const c of corners){
      const w = tr.toWorld(c.lx, c.ly);
      if(Math.hypot(w.x-mx, w.y-my) < 14) return c.name;
    }
    return null;
  }
  function hitBody(layerId, mx, my){
    const tr = layerTransform(layerId);
    const rad = -Math.atan2(tr.sin, tr.cos);
    const c = Math.cos(rad), s = Math.sin(rad);
    const dx = mx-tr.cx, dy = my-tr.cy;
    const rx = c*dx-s*dy, ry = s*dx+c*dy;
    const lx = rx+tr.px, ly = ry+tr.py;
    return lx>=0 && lx<=tr.w && ly>=0 && ly<=tr.h;
  }

  canvas.addEventListener('pointerdown', (e)=>{
    if(e.button !== undefined && e.button !== 0) return;
    const m = mousePos(e);
    if(T.selectedLayer){
      const corner = hitCorner(T.selectedLayer, m.x, m.y);
      if(corner){
        mode = 'resizeLayer'; dragLayer = T.selectedLayer; resizeCorner = corner;
        const st = layerEffectiveSt(T.anim, dragLayer);
        startState = { x:st.x, y:st.y, w:st.w, h:st.h };
        startCanvasX = m.x; startCanvasY = m.y;
        canvas.setPointerCapture(e.pointerId);
        return;
      }
    }
    const sortedEq = T.equipment.slice().filter(eq => shouldShowEq(eq)).sort((a,b)=>{
      const la = LAYERS.find(l=>l.id===a.layer), lb = LAYERS.find(l=>l.id===b.layer);
      const za = (la?la.z:0) + (a.behind?-0.5:0.5);
      const zb = (lb?lb.z:0) + (b.behind?-0.5:0.5);
      return zb - za;
    });
    for(const eq of sortedEq){
      if(!eq.img) continue;
      const L = LAYERS.find(l=>l.id===eq.layer); if(!L) continue;
      const tr = layerTransform(L.id);
      const img = getImg(eq.img); if(!img || !img.naturalWidth) continue;
      const localX = tr.px + tr.w*(eq.ox||0), localY = tr.py + tr.h*(eq.oy||0);
      const wc = tr.toWorld(localX, localY);
      const baseW = CW*(eq.scale||0.3);
      const baseH = baseW / (img.naturalWidth/img.naturalHeight);
      const dx = m.x-wc.x, dy = m.y-wc.y;
      const a = -Math.atan2(tr.sin, tr.cos), c = Math.cos(a), s = Math.sin(a);
      const rx = c*dx-s*dy, ry = s*dx+c*dy;
      if(Math.abs(rx) <= baseW/2 && Math.abs(ry) <= baseH/2){
        T.selectedEq = eq.id; T.selectedLayer = null;
        mode = 'moveEq'; dragEq = eq;
        lastMx = m.x; lastMy = m.y;
        canvas.setPointerCapture(e.pointerId);
        renderAll();
        return;
      }
    }
    const sortedLayers = LAYERS.slice().sort((a,b)=>b.z-a.z);
    for(const L of sortedLayers){
      if(hitBody(L.id, m.x, m.y)){
        T.selectedLayer = L.id; T.selectedEq = null;
        mode = 'moveLayer'; dragLayer = L.id;
        const st = layerEffectiveSt(T.anim, L.id);
        startState = { x:st.x, y:st.y, w:st.w, h:st.h };
        startCanvasX = m.x; startCanvasY = m.y;
        canvas.setPointerCapture(e.pointerId);
        renderAll();
        return;
      }
    }
    T.selectedLayer = null; T.selectedEq = null;
    renderAll();
  });

  canvas.addEventListener('pointermove', (e)=>{
    if(!mode){
      const m = mousePos(e);
      let cursor = 'default';
      if(T.selectedLayer){
        const corner = hitCorner(T.selectedLayer, m.x, m.y);
        if(corner) cursor = corner==='nw'||corner==='se' ? 'nwse-resize' : 'nesw-resize';
        else if(hitBody(T.selectedLayer, m.x, m.y)) cursor = 'move';
      }
      canvas.style.cursor = cursor;
      return;
    }
    const m = mousePos(e);
    const B = heroBox();
    if(mode === 'moveLayer'){
      const dx = m.x - startCanvasX, dy = m.y - startCanvasY;
      setLayerSt(dragLayer, { x: startState.x + dx/B.w, y: startState.y + dy/B.h });
      scheduleSave(); renderLeftList();
    } else if(mode === 'resizeLayer'){
      const dx = m.x - startCanvasX, dy = m.y - startCanvasY;
      const dwx = dx/B.w, dhy = dy/B.h;
      let { x, y, w, h } = startState;
      let cx = x, cy = y;
      if(resizeCorner.includes('e')){ w = startState.w + dwx; cx = startState.x + dwx/2; }
      if(resizeCorner.includes('w')){ w = startState.w - dwx; cx = startState.x + dwx/2; }
      if(resizeCorner.includes('s')){ h = startState.h + dhy; cy = startState.y + dhy/2; }
      if(resizeCorner.includes('n')){ h = startState.h - dhy; cy = startState.y + dhy/2; }
      setLayerSt(dragLayer, { w: Math.max(0.01, w), h: Math.max(0.01, h), x: cx, y: cy });
      scheduleSave(); renderLeftList();
    } else if(mode === 'moveEq'){
      const L = LAYERS.find(l=>l.id===dragEq.layer); if(!L) return;
      const tr = layerTransform(L.id);
      const dx = m.x - lastMx, dy = m.y - lastMy;
      const a = -Math.atan2(tr.sin, tr.cos), c = Math.cos(a), s = Math.sin(a);
      const ldx = c*dx-s*dy, ldy = s*dx+c*dy;
      dragEq.ox = (dragEq.ox||0) + ldx/tr.w;
      dragEq.oy = (dragEq.oy||0) + ldy/tr.h;
      lastMx = m.x; lastMy = m.y;
      scheduleSave();
    }
  });

  canvas.addEventListener('pointerup', (e)=>{
    if(mode){
      mode = null; dragLayer = null; dragEq = null;
      try{ canvas.releasePointerCapture(e.pointerId); }catch(_){}
      scheduleSave(); renderAll();
    }
  });
  canvas.addEventListener('pointercancel', ()=>{ mode=null; dragLayer=null; dragEq=null; });

  document.addEventListener('keydown', (e)=>{
    const tag = (e.target.tagName || '').toUpperCase();
    if(tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
    if(!T.selectedLayer) return;
    let dx = 0, dy = 0;
    const step = e.shiftKey ? 0.02 : 0.002;
    if(e.key === 'ArrowLeft') dx = -step;
    else if(e.key === 'ArrowRight') dx = step;
    else if(e.key === 'ArrowUp') dy = -step;
    else if(e.key === 'ArrowDown') dy = step;
    else return;
    e.preventDefault();
    const cur = layerEffectiveSt(T.anim, T.selectedLayer);
    setLayerSt(T.selectedLayer, { x: cur.x + dx, y: cur.y + dy });
    scheduleSave(); renderAll();
  });
}

function updateContextTag(){
  const labels = {primary:'主武器', secondary:'副武器', melee:'近戰'};
  const el = $('#ctxTag');
  if(el) el.textContent = '受擊顯示：' + (labels[T.weaponContext] || '主武器');
}

function updateSecondaryModeUI(){
  $('#secPistolBtn').classList.toggle('on', T.secondaryMode === 'pistol');
  $('#secShotgunBtn').classList.toggle('on', T.secondaryMode === 'shotgun');
}
function updateTopModeUI(){
  $('#topNormalBtn').classList.toggle('on', T.topMode === 'normal');
  $('#topArmoredBtn').classList.toggle('on', T.topMode === 'armored');
}

function bindUI(){
  $('#btnAddEq').onclick = ()=>{
    const eq = { id: uid(), name:'', type:'head', layer:'head', behind:false, img:'', scale:0.26, ox:0, oy:-0.06, rotation:0 };
    T.equipment.push(eq);
    T.selectedEq = eq.id; T.selectedLayer = null;
    scheduleSave(); renderAll();
    const input = document.createElement('input');
    input.type = 'file'; input.accept = 'image/*';
    input.onchange = (e)=>{
      const f = e.target.files[0]; if(!f) return;
      const r = new FileReader();
      r.onload = ()=>{ eq.img = r.result; getImg(eq.img); applyAutoMount(eq); scheduleSave(); renderAll(); toast('已加入装备'); };
      r.readAsDataURL(f);
    };
    input.click();
  };

  $$('#animBar [data-anim]').forEach(b=>{
    b.onclick = ()=>{
      const newAnim = b.dataset.anim;
      const sa = ANIMS[newAnim] && ANIMS[newAnim].showEq;
      if(sa && sa !== 'all' && sa !== 'context'){
        T.weaponContext = sa;
        updateContextTag();
      }
      T.anim = newAnim;
      T.currentFrame = 0;
      T.playing = true;
      $('#btnPlay').textContent = '⏸';
      $$('#animBar [data-anim]').forEach(x=>x.classList.toggle('on', x===b));
      lastT = performance.now();
      scheduleSave();
      renderAll();
    };
  });

  $('#secPistolBtn').onclick = ()=>{
    T.secondaryMode = 'pistol';
    updateSecondaryModeUI();
    scheduleSave(); renderAll();
    toast('副武器顯示：手槍');
  };
  $('#secShotgunBtn').onclick = ()=>{
    T.secondaryMode = 'shotgun';
    updateSecondaryModeUI();
    scheduleSave(); renderAll();
    toast('副武器顯示：霰彈槍');
  };
  $('#topNormalBtn').onclick = ()=>{
    T.topMode = 'normal';
    updateTopModeUI();
    scheduleSave(); renderAll();
    toast('上衣顯示：一般上衣 / 甲');
  };
  $('#topArmoredBtn').onclick = ()=>{
    T.topMode = 'armored';
    updateTopModeUI();
    scheduleSave(); renderAll();
    toast('上衣顯示：帶護臂甲');
  };

  $('#ctxTag').onclick = ()=>{
    const order = ['primary','secondary','melee'];
    const cur = order.indexOf(T.weaponContext);
    T.weaponContext = order[(cur+1)%order.length];
    updateContextTag();
    scheduleSave();
    renderAll();
  };

  $('#btnPlay').onclick = ()=>{
    T.playing = !T.playing;
    $('#btnPlay').textContent = T.playing ? '⏸' : '▶';
    if(T.playing) lastT = performance.now();
    scheduleSave();
  };
  $('#speed').oninput = (e)=>{
    T.speed = parseInt(e.target.value,10) || 10;
    $('#speedVal').textContent = T.speed;
    scheduleSave();
  };

  $$('.sec .fold').forEach(f=>{
    f.onclick = ()=>{
      const sec = f.closest('.sec');
      sec.classList.toggle('folded');
      f.textContent = sec.classList.contains('folded') ? '+' : '−';
    };
  });

  $('#btnReset').onclick = ()=>{
    if(!confirm('重置所有内容？此操作不可撤销。')) return;
    T = defaultState(); save(); renderAll();
  };

  $('#btnExport').onclick = ()=>{
    const data = JSON.stringify({
      canvas:{w:CW,h:CH},
      layers:T.layers,
      animPositions:T.animPositions,
      equipment:T.equipment,
      anim:T.anim,
      weaponContext:T.weaponContext,
      secondaryMode:T.secondaryMode,
      topMode:T.topMode,
      anims:ANIMS,
      version:'v7.4'
    }, null, 2);
    const a = document.createElement('a');
    a.href = 'data:application/json;charset=utf-8,' + encodeURIComponent(data);
    a.download = 'layered_doll.json'; a.click();
    toast('已下载设定');
  };
}

function renderAll(){
  $$('#animBar [data-anim]').forEach(b=>b.classList.toggle('on', b.dataset.anim===T.anim));
  $('#speed').value = T.speed;
  $('#speedVal').textContent = T.speed;
  $('#btnPlay').textContent = T.playing ? '⏸' : '▶';
  updateContextTag();
  updateSecondaryModeUI();
  updateTopModeUI();
  const secExtra = $('#secExtra');
  if(secExtra && T.folded.secExtra){ secExtra.classList.add('folded'); secExtra.querySelector('.fold').textContent = '+'; }
  renderLeftList();
  renderEqList();
  renderLayerDetail();
  renderEqDetail();
  render();
}

bindUI();
bindCanvas();
renderAll();
lastT = performance.now();
rafId = requestAnimationFrame(tick);
console.log('分層人偶編輯器 v7.4 已啟動');
</script>
</body>
</html>
