function defaultState(){
  const layers = {};
  for(const L of LAYERS) layers[L.id] = { img:'', x:L.def.x, y:L.def.y, w:L.def.w, h:L.def.h };
  return {
    layers,
    animPositions: {},
    equipment: [],
    anim:'idle', speed:10, playing:true, selectedEq:null, selectedLayer:'torso', currentFrame:0, folded:{},
    weaponContext: 'primary',
    secondaryMode: 'pistol',
    topMode: 'normal',       // 'normal' | 'armored'
  };
}
let T = load() || defaultState();

(function migrate(){
  const oldToNew = { back_leg:'left_leg', front_leg:'right_leg' };
  if(T.layers){
    for(const oldId in oldToNew){
      if(T.layers[oldId] && !T.layers[oldToNew[oldId]]) T.layers[oldToNew[oldId]] = T.layers[oldId];
      delete T.layers[oldId];
    }
  }
  for(const L of LAYERS){
    if(!T.layers[L.id]) T.layers[L.id] = { img:'', x:L.def.x, y:L.def.y, w:L.def.w, h:L.def.h };
    const st = T.layers[L.id];
    if(st.x === undefined) st.x = L.def.x;
    if(st.y === undefined) st.y = L.def.y;
    if(st.w === undefined) st.w = L.def.w;
    if(st.h === undefined) st.h = L.def.h;
  }
  for(const eq of (T.equipment||[])) if(oldToNew[eq.layer]) eq.layer = oldToNew[eq.layer];
  for(const eq of (T.equipment||[])){
    if(eq.type === 'secondary') eq.type = 'secondary_pistol';
  }
  if(!T.selectedLayer) T.selectedLayer = 'torso';
  if(!ANIMS[T.anim]) T.anim = 'idle';
  T.folded = T.folded || {};
  T.animPositions = T.animPositions || {};
  if(!T.weaponContext) T.weaponContext = 'primary';
  if(!T.secondaryMode) T.secondaryMode = 'pistol';
  if(!T.topMode) T.topMode = 'normal';
})();

const imgCache = new Map();
let saveTimer = null;
let rafId = null;
let lastT = performance.now();

function $(s,e){ return (e||document).querySelector(s); }
function $$(s,e){ return Array.from((e||document).querySelectorAll(s)); }
function toast(msg, err){
  const el = $('#toast'); el.textContent = msg; el.className = 'on' + (err?' err':'');
  clearTimeout(toast._t); toast._t = setTimeout(()=>el.className='', 1500);
}
function load(){ try{ const r=localStorage.getItem(STORAGE_KEY); return r?JSON.parse(r):null; }catch(e){ return null; } }
function save(){ try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(T)); }catch(e){} }
function scheduleSave(){ if(saveTimer) clearTimeout(saveTimer); saveTimer=setTimeout(save,400); }
function uid(){ return 'eq'+(Math.random()*1e8|0).toString(36); }

function getImg(url){
  if(!url) return null;
  if(imgCache.has(url)) return imgCache.get(url);
  const img = new Image();
  img.onload = ()=>{ renderLeftList(); renderEqList(); };
  img.onerror = ()=>{};
  img.src = url;
  imgCache.set(url, img);
  return img;
}

function drawContain(ctx, img, cx, cy, boxW, boxH){
  const ar = img.naturalWidth / img.naturalHeight;
  const boxAr = boxW / boxH;
  let dw, dh;
  if(ar > boxAr){ dw = boxW; dh = boxW / ar; }
  else { dh = boxH; dw = boxH * ar; }
  ctx.drawImage(img, cx - dw/2, cy - dh/2, dw, dh);
}

function layerBaseSt(layerId){ return T.layers[layerId]; }
function layerOverride(anim, layerId){
  return T.animPositions && T.animPositions[anim] && T.animPositions[anim][layerId];
}
function layerEffectiveSt(anim, layerId){
  const base = layerBaseSt(layerId);
  const ov = layerOverride(anim, layerId);
  if(!ov) return base;
  return { x:ov.x, y:ov.y, w:ov.w, h:ov.h, img: base.img };
}
function setLayerSt(layerId, patch){
  if(T.anim === 'idle'){
    const st = T.layers[layerId];
    for(const k in patch) st[k] = patch[k];
  } else {
    if(!T.animPositions[T.anim]) T.animPositions[T.anim] = {};
    if(!T.animPositions[T.anim][layerId]){
      const b = T.layers[layerId];
      T.animPositions[T.anim][layerId] = { x:b.x, y:b.y, w:b.w, h:b.h };
    }
    const ov = T.animPositions[T.anim][layerId];
    for(const k in patch) ov[k] = patch[k];
  }
}
function clearOverride(anim, layerId){
  if(T.animPositions && T.animPositions[anim]){
    delete T.animPositions[anim][layerId];
    if(Object.keys(T.animPositions[anim]).length === 0) delete T.animPositions[anim];
  }
}
function hasOverride(anim, layerId){ return !!layerOverride(anim, layerId); }

function currentAnim(){ return ANIMS[T.anim] || ANIMS.idle; }
function getFrameIdx(){ const a = currentAnim(); return ((T.currentFrame % a.frameCount) + a.frameCount) % a.frameCount; }
function getKey(layerId){
  const a = currentAnim();
  const arr = a.keys && a.keys[layerId];
  if(!arr) return {rot:0,dx:0,dy:0};
  return arr[Math.min(getFrameIdx(), arr.length-1)] || {rot:0,dx:0,dy:0};
}

function matchesSecondaryMode(type){
  if(type === 'secondary_pistol')  return T.secondaryMode === 'pistol';
  if(type === 'secondary_shotgun') return T.secondaryMode === 'shotgun';
  return false;
}
function matchesTopMode(type){
  if(type === 'top')         return T.topMode === 'normal';
  if(type === 'top_armored') return T.topMode === 'armored';
  return true;
}

/* ★ v7.4：上衣只顯示一種（依 topMode），副武器同理 */
function shouldShowEq(eq){
  const type = eq.type;
  const isSecondary = (type === 'secondary_pistol' || type === 'secondary_shotgun');
  const isTop = (type === 'top' || type === 'top_armored');

  if(!['primary','secondary_pistol','secondary_shotgun','melee','throwable'].includes(type)){
    if(isTop) return matchesTopMode(type);
    return true;
  }
  const show = currentAnim().showEq;
  if(!show) return true;
  if(show === 'all') return true;
  if(show === 'context'){
    if(T.weaponContext === 'secondary') return isSecondary && matchesSecondaryMode(type);
    return type === (T.weaponContext || 'primary');
  }
  if(show === 'secondary'){
    return isSecondary && matchesSecondaryMode(type);
  }
  return type === show;
}

function heroBox(){ return {x:30, y:30, w:CW-60, h:CH-60}; }

function layerRect(layerId){
  const st = layerEffectiveSt(T.anim, layerId);
  if(!st) return {cx:0, cy:0, w:0, h:0};
  const B = heroBox();
  const key = getKey(layerId);
  return {
    cx: B.x + B.w * (st.x + (key.dx||0) * 0.01),
    cy: B.y + B.h * (st.y + (key.dy||0) * 0.01),
    w: B.w * st.w,
    h: B.h * st.h,
  };
}

function layerTransform(layerId){
  const L = LAYERS.find(l=>l.id===layerId);
  const r = layerRect(layerId);
  const key = getKey(layerId);
  const px = r.w * L.pivot.x;
  const py = r.h * L.pivot.y;
  const rad = (key.rot||0) * Math.PI/180;
  const cos = Math.cos(rad), sin = Math.sin(rad);
  return {
    px, py, cx: r.cx, cy: r.cy, cos, sin, w: r.w, h: r.h,
    toWorld(lx, ly){
      return { x: r.cx + cos*(lx-px) - sin*(ly-py), y: r.cy + sin*(lx-px) + cos*(ly-py) };
    }
  };
}

function render(){
  const canvas = $('#canvas');
  canvas.width = CW; canvas.height = CH;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0,0,CW,CH);
  drawChecker(ctx, CW, CH, 20);

  const units = [];
  for(const L of LAYERS){
    units.push({ z: L.z, kind:'layer', layer: L });
    for(const eq of T.equipment){
      if(eq.layer !== L.id) continue;
      if(!shouldShowEq(eq)) continue;
      const z = L.z + (eq.behind ? -0.5 : 0.5);
      units.push({ z, kind:'eq', layer: L, eq });
    }
  }
  units.sort((a,b)=>a.z-b.z);
  for(const u of units){
    if(u.kind === 'layer') drawLayer(ctx, u.layer);
    else drawEq(ctx, u.eq, u.layer);
  }

  if(T.selectedLayer){
    const L = LAYERS.find(l=>l.id===T.selectedLayer);
    if(L){
      const tr = layerTransform(L.id);
      const ov = hasOverride(T.anim, L.id);
      ctx.save();
      ctx.translate(tr.cx, tr.cy);
      ctx.rotate(Math.atan2(tr.sin, tr.cos));
      ctx.translate(-tr.px, -tr.py);
      ctx.strokeStyle = ov ? '#4caf50' : (L.group === 'core' ? '#ffb300' : '#8a7f60');
      ctx.lineWidth = 2;
      ctx.setLineDash([5,3]);
      ctx.strokeRect(0, 0, tr.w, tr.h);
      ctx.setLineDash([]);
      const corners = [[0,0],[tr.w,0],[0,tr.h],[tr.w,tr.h]];
      ctx.fillStyle = ctx.strokeStyle;
      ctx.strokeStyle = '#0a0806';
      ctx.lineWidth = 2;
      for(const [cx, cy] of corners){ ctx.fillRect(cx-5, cy-5, 10, 10); ctx.strokeRect(cx-5, cy-5, 10, 10); }
      ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(tr.px-8, tr.py); ctx.lineTo(tr.px+8, tr.py); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(tr.px, tr.py-8); ctx.lineTo(tr.px, tr.py+8); ctx.stroke();
      ctx.restore();
    }
  }
}

function drawChecker(ctx, w, h, s){
  for(let y=0;y<h;y+=s) for(let x=0;x<w;x+=s){
    ctx.fillStyle = ((x/s)+(y/s))%2===0 ? '#14110c' : '#181410';
    ctx.fillRect(x,y,s,s);
  }
}

function drawLayer(ctx, L){
  const tr = layerTransform(L.id);
  const st = T.layers[L.id] || {};
  const img = st.img ? getImg(st.img) : null;
  ctx.save();
  ctx.translate(tr.cx, tr.cy);
  ctx.rotate(Math.atan2(tr.sin, tr.cos));
  ctx.translate(-tr.px, -tr.py);
  if(img && img.complete && img.naturalWidth){
    drawContain(ctx, img, tr.w/2, tr.h/2, tr.w, tr.h);
  } else {
    ctx.fillStyle = L.color;
    ctx.fillRect(0, 0, tr.w, tr.h);
    ctx.strokeStyle = 'rgba(0,0,0,.7)';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(0.75, 0.75, tr.w-1.5, tr.h-1.5);
  }
  ctx.restore();
}

function drawEq(ctx, eq, L){
  const img = getImg(eq.img);
  if(!img || !img.complete || !img.naturalWidth) return;
  const tr = layerTransform(L.id);
  const localX = tr.px + tr.w * (eq.ox || 0);
  const localY = tr.py + tr.h * (eq.oy || 0);
  const baseW = CW * (eq.scale || 0.3);
  const ar = img.naturalWidth / img.naturalHeight;
  const baseH = baseW / ar;
  ctx.save();
  ctx.translate(tr.cx, tr.cy);
  ctx.rotate(Math.atan2(tr.sin, tr.cos));
  ctx.translate(-tr.px, -tr.py);
  ctx.translate(localX, localY);
  if(eq.rotation) ctx.rotate(eq.rotation * Math.PI/180);
  ctx.drawImage(img, -baseW/2, -baseH/2, baseW, baseH);
  ctx.restore();
}

function tick(now){
  if(T.playing){
    const a = currentAnim();
    const dt = (now - lastT) / 1000;
    const frameDuration = 1 / (a.fps * T.speed / 10);
    if(dt >= frameDuration){
      if(a.loop !== false){
        T.currentFrame = (T.currentFrame + 1) % a.frameCount;
      } else {
        if(T.currentFrame < a.frameCount - 1) T.currentFrame++;
      }
      lastT = now;
    }
    render();
  }
  rafId = requestAnimationFrame(tick);
}

function renderLeftList(){
  const coreBox = $('#coreLayerList');
  const extraBox = $('#extraLayerList');
  coreBox.innerHTML = '';
  extraBox.innerHTML = '';
  const sorted = LAYERS.slice().sort((a,b)=>a.z-b.z);
  for(const L of sorted){
    const st = T.layers[L.id] || {};
    const eff = layerEffectiveSt(T.anim, L.id);
    const ov = hasOverride(T.anim, L.id);
    const img = st.img ? getImg(st.img) : null;
    const card = document.createElement('div');
    card.className = 'layerCard ' + L.group + (T.selectedLayer===L.id?' selected':'');
    card.innerHTML = `
      <div class="lc-head">
        <div class="ico">${img?`<img src="${st.img}">`:''}</div>
        <div class="nm">${L.name}</div>
        <div class="ztag">z${L.z}${ov?' <span style="color:#4caf50">✦</span>':''}</div>
        <div class="btns">${st.img?'<button data-clear="1">✕</button>':''}</div>
      </div>
      <div class="uploadRow">
        <label for="layerFile_${L.id}">${st.img?'更換圖片':'上傳圖片'}</label>
        <input type="file" id="layerFile_${L.id}" accept="image/*">
      </div>
      <div class="info">x=${eff.x.toFixed(3)} y=${eff.y.toFixed(3)} w=${eff.w.toFixed(3)} h=${eff.h.toFixed(3)}</div>
    `;
    card.querySelector(`#layerFile_${L.id}`).onchange = (e)=>{
      const f = e.target.files[0]; if(!f) return;
      const r = new FileReader();
      r.onload = ()=>{ T.layers[L.id].img = r.result; getImg(r.result); scheduleSave(); renderLeftList(); };
      r.readAsDataURL(f);
    };
    const clr = card.querySelector('[data-clear]');
    if(clr) clr.onclick = (ev)=>{ ev.stopPropagation(); T.layers[L.id].img=''; scheduleSave(); renderLeftList(); };
    card.onclick = (ev)=>{
      if(ev.target.tagName === 'INPUT' || ev.target.tagName === 'LABEL') return;
      T.selectedLayer = L.id; T.selectedEq = null; scheduleSave(); renderAll();
    };
    (L.group === 'core' ? coreBox : extraBox).appendChild(card);
  }
}

function renderEqList(){
  const box = $('#eqList');
  box.innerHTML = '';
  if(!T.equipment.length){ box.innerHTML = '<div class="hint">还没有装备。点「+ 新增」加一件。</div>'; return; }
  for(const eq of T.equipment){
    const tp = EQ_TYPES.find(x=>x.id===eq.type) || {name:'?'};
    const card = document.createElement('div');
    card.className = 'eqCard' + (T.selectedEq===eq.id?' selected':'');
    card.innerHTML = `
      <div class="ec-head">
        <div class="ico">${eq.img?`<img src="${eq.img}">`:''}</div>
        <div class="nm">${eq.name || tp.name}</div>
        <div class="del" data-del="1">✕</div>
      </div>
      <div class="ec-body">${tp.name} · 掛載: ${eq.layer}</div>
    `;
    card.onclick = (e)=>{ if(e.target.dataset.del) return; T.selectedEq = eq.id; T.selectedLayer = null; scheduleSave(); renderAll(); };
    card.querySelector('[data-del]').onclick = (e)=>{
      e.stopPropagation();
      T.equipment = T.equipment.filter(x=>x.id!==eq.id);
      if(T.selectedEq===eq.id) T.selectedEq = null;
      scheduleSave(); renderAll();
    };
    box.appendChild(card);
  }
}

function renderLayerDetail(){
  const box = $('#layerDetailBody');
  const L = LAYERS.find(l=>l.id===T.selectedLayer);
  if(!L){ box.innerHTML = '<div class="hint">点左侧卡片或画布色块选中一层。</div>'; return; }
  const ov = hasOverride(T.anim, L.id);
  const isIdle = T.anim === 'idle';
  const eff = layerEffectiveSt(T.anim, L.id);
  let badge, btn;
  if(isIdle){
    badge = '<span class="modeBadge base">基礎位置（idle）</span>';
    btn = '';
  } else if(ov){
    badge = '<span class="modeBadge override">本動作獨立</span>';
    btn = '<button id="ldClearOv" style="flex:1;background:#241d16;border:1px solid #3a2f25;color:#a89a85;border-radius:5px;padding:6px;font-size:10px;cursor:pointer">與基礎共用</button>';
  } else {
    badge = '<span class="modeBadge base">與基礎共用</span>';
    btn = '<button id="ldMakeOv" style="flex:1;background:#241d16;border:1px solid #3a2f25;color:#a89a85;border-radius:5px;padding:6px;font-size:10px;cursor:pointer">本動作獨立</button>';
  }
  box.innerHTML = `
    <div class="row"><label>名称</label><span style="flex:1;color:#e8a33d">${L.name}</span></div>
    <div class="row"><label>動作</label><span style="flex:1;color:#a89a85;font-size:10px">${T.anim}</span></div>
    <div class="row"><label>位置模式</label>${badge}</div>
    <div class="row"><label>中心 X</label><input type="number" id="ldX" value="${eff.x.toFixed(3)}" step="0.005"></div>
    <div class="row"><label>中心 Y</label><input type="number" id="ldY" value="${eff.y.toFixed(3)}" step="0.005"></div>
    <div class="row"><label>宽</label><input type="number" id="ldW" value="${eff.w.toFixed(3)}" step="0.005" min="0.01"></div>
    <div class="row"><label>高</label><input type="number" id="ldH" value="${eff.h.toFixed(3)}" step="0.005" min="0.01"></div>
    <div class="row" style="margin-top:6px">
      <button id="ldReset" style="flex:1;background:#241d16;border:1px solid #3a2f25;color:#a89a85;border-radius:5px;padding:6px;font-size:10px;cursor:pointer">重置此層位置</button>
    </div>
    <div class="row">${btn}</div>
    <div class="hint" style="color:#4caf50">✦ = 该动作下此层已独立覆盖位置</div>
  `;
  const bind = (sel, key)=>{
    $(sel).oninput = (e)=>{
      const v = parseFloat(e.target.value);
      if(isNaN(v)) return;
      setLayerSt(L.id, { [key]: v });
      scheduleSave(); renderLeftList(); renderLayerDetail();
    };
  };
  bind('#ldX','x'); bind('#ldY','y'); bind('#ldW','w'); bind('#ldH','h');
  $('#ldReset').onclick = ()=>{
    if(isIdle){ setLayerSt(L.id, { x:L.def.x, y:L.def.y, w:L.def.w, h:L.def.h }); }
    else { clearOverride(T.anim, L.id); }
    scheduleSave(); renderAll();
  };
  const makeBtn = $('#ldMakeOv');
  if(makeBtn) makeBtn.onclick = ()=>{
    const src = layerEffectiveSt(T.anim, L.id);
    setLayerSt(L.id, { x:src.x, y:src.y, w:src.w, h:src.h });
    scheduleSave(); renderAll();
  };
  const clearBtn = $('#ldClearOv');
  if(clearBtn) clearBtn.onclick = ()=>{
    clearOverride(T.anim, L.id);
    scheduleSave(); renderAll();
  };
}

