<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>分層人偶編輯器 v7.4</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#0e0c0a;color:#ddd;font-family:-apple-system,"PingFang TC","Microsoft JhengHei",sans-serif;font-size:12px}
#app{display:flex;flex-direction:column;height:100vh}
header{flex:0 0 auto;padding:8px 12px;background:#1a1510;border-bottom:1px solid #2a231c;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
header h1{font-size:14px;color:#e8a33d;font-weight:bold}
header .hint{font-size:10px;color:#7a6f60}
header .spacer{flex:1}
header button{background:#241d16;border:1px solid #3a2f25;color:#a89a85;border-radius:6px;padding:6px 12px;font-size:11px;cursor:pointer}
header button:hover{border-color:#e8a33d;color:#e8a33d}
main{flex:1;min-height:0;display:flex}
aside{background:#151210;overflow-y:auto}
aside::-webkit-scrollbar{width:6px}
aside::-webkit-scrollbar-thumb{background:#3a2f25;border-radius:3px}
#left{flex:0 0 300px;border-right:1px solid #2a231c}
#center{flex:1;min-width:0;display:flex;flex-direction:column;background:#0a0806}
#right{flex:0 0 280px;border-left:1px solid #2a231c}
.sec{padding:10px;border-bottom:1px solid #2a231c}
.sec h3{font-size:11px;color:#e8a33d;font-weight:bold;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center}
.sec h3 .fold{color:#7a6f60;cursor:pointer;font-size:14px;user-select:none;padding:0 4px}
.sec.folded .secBody{display:none}
.secBody{display:flex;flex-direction:column;gap:5px}
.row{display:flex;align-items:center;gap:6px;margin-bottom:6px}
.row label{flex:0 0 66px;color:#7a6f60;font-size:10px}
.row input[type=text],.row select,.row input[type=number]{flex:1;min-width:0;background:#1a1510;border:1px solid #3a2f25;border-radius:4px;padding:5px 8px;color:#e0e0e0;font-size:11px}
.row input:focus,.row select:focus{outline:none;border-color:#e8a33d}
.row input[type=range]{flex:1;min-width:0}
.row .val{flex:0 0 44px;text-align:right;color:#e8a33d;font-family:monospace;font-size:10px}
.layerCard{background:#1a1510;border:1px solid #2a231c;border-radius:6px;padding:8px;margin-bottom:6px;cursor:pointer}
.layerCard.selected{border-color:#e8a33d;background:#241d16}
.layerCard.core{border-left:3px solid #e8a33d}
.layerCard.extra{border-left:3px solid #5a5040;opacity:.8}
.layerCard .lc-head{display:flex;align-items:center;gap:6px;margin-bottom:6px}
.layerCard .lc-head .ico{width:26px;height:26px;border-radius:4px;background:#0a0806;border:1px solid #2a231c;display:flex;align-items:center;justify-content:center;overflow:hidden;flex:0 0 26px}
.layerCard .lc-head .ico img{width:100%;height:100%;object-fit:contain}
.layerCard .lc-head .nm{flex:1;font-size:11px;color:#ddd}
.layerCard .lc-head .ztag{font-size:9px;color:#5a5040;font-family:monospace}
.layerCard .lc-head .btns button{background:#241d16;border:1px solid #3a2f25;color:#a89a85;border-radius:4px;padding:2px 6px;font-size:10px;cursor:pointer;margin-left:3px}
.layerCard .uploadRow{display:flex;gap:4px;margin-bottom:6px}
.layerCard .uploadRow input[type=file]{display:none}
.layerCard .uploadRow label,.layerCard .uploadRow button{flex:1;background:#241d16;border:1px solid #3a2f25;color:#a89a85;border-radius:4px;padding:5px;font-size:10px;cursor:pointer;text-align:center}
.layerCard .uploadRow label:hover{border-color:#e8a33d}
.layerCard .info{font-size:9px;color:#7a6f60;font-family:monospace}
.eqCard{background:#1a1510;border:1px solid #2a231c;border-radius:6px;padding:8px;margin-bottom:6px;cursor:pointer}
.eqCard.selected{border-color:#e8a33d;background:#241d16}
.eqCard .ec-head{display:flex;align-items:center;gap:6px;margin-bottom:6px}
.eqCard .ec-head .ico{width:28px;height:28px;border-radius:4px;background:#0a0806;border:1px solid #2a231c;display:flex;align-items:center;justify-content:center;overflow:hidden}
.eqCard .ec-head .ico img{width:100%;height:100%;object-fit:contain}
.eqCard .ec-head .nm{flex:1;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.eqCard .ec-head .del{color:#7a6f60;font-size:14px;padding:0 4px;cursor:pointer}
.eqCard .ec-head .del:hover{color:#e05252}
.eqCard .ec-body{font-size:9px;color:#7a6f60}
#canvasWrap{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;overflow:auto;padding:16px;position:relative}
#canvas{background:#14110c;border:1px solid #2a231c;border-radius:6px;box-shadow:0 8px 32px rgba(0,0,0,.6);cursor:default;touch-action:none}
#animBar{flex:0 0 auto;background:#17140f;border-top:1px solid #2a231c;padding:8px 12px;display:flex;align-items:center;gap:5px;flex-wrap:wrap}
#animBar button{background:#241d16;border:1px solid #3a2f25;color:#a89a85;border-radius:5px;padding:5px 10px;font-size:11px;cursor:pointer;white-space:nowrap}
#animBar button.on{background:#8a5f18;color:#fff;border-color:#e8a33d}
#animBar button.pose{color:#d0b070}
#animBar button.pose.on{background:#a0701e;color:#fff}
#animBar button.sec{color:#6ab8e8;border-color:#2a4258}
#animBar button.sec.on{background:#1e5f8a;color:#fff;border-color:#4a9ed9}
#animBar button.top{color:#c890d8;border-color:#4a2a58}
#animBar button.top.on{background:#7a3e9a;color:#fff;border-color:#c890d8}
#animBar label{font-size:10px;color:#7a6f60;margin-left:4px}
#animBar input[type=range]{width:70px}
#animBar .val{font-size:10px;color:#e8a33d;font-family:monospace;min-width:26px}
#animBar .sep{width:1px;height:20px;background:#2a231c;margin:0 4px;flex:0 0 auto}
#animBar .groupLabel{font-size:10px;color:#5a5040;padding:0 4px}
#animBar .ctxTag{font-size:10px;color:#4caf50;background:#1a2a1a;border:1px solid #2a4a2a;border-radius:4px;padding:2px 6px;cursor:pointer;user-select:none}
#animBar .ctxTag:hover{border-color:#4caf50}
#toast{position:fixed;top:18%;left:50%;transform:translateX(-50%);background:rgba(30,24,19,.96);border:1px solid #e8a33d;border-radius:8px;padding:8px 14px;color:#e8a33d;font-size:12px;z-index:10000;opacity:0;pointer-events:none;transition:opacity .2s}
#toast.on{opacity:1}
#toast.err{border-color:#e05252;color:#e05252}
.hint{font-size:10px;color:#5a5040;line-height:1.6;padding:4px 0}
.modeBadge{display:inline-block;font-size:9px;padding:2px 6px;border-radius:3px;font-weight:bold}
.modeBadge.base{background:#3a2a15;color:#e8a33d}
.modeBadge.override{background:#1e3a2a;color:#4caf50}
</style>
</head>
<body>
<div id="app">
  <header>
    <h1>🧩 分層人偶編輯器 v7.4</h1>
    <span class="hint">主/副武器後坐上抬 · 上衣單件顯示</span>
    <span class="spacer"></span>
    <button id="btnReset">重置</button>
    <button id="btnExport">匯出設定</button>
  </header>
  <main>
    <aside id="left">
      <div class="sec">
        <h3><span>🎯 核心層</span></h3>
        <div id="coreLayerList"></div>
      </div>
      <div class="sec folded" id="secExtra">
        <h3><span>🧱 其他層（可折叠）</span><span class="fold" data-fold="secExtra">+</span></h3>
        <div class="secBody" id="extraLayerList"></div>
      </div>
    </aside>
    <section id="center">
      <div id="canvasWrap">
        <canvas id="canvas" width="400" height="520"></canvas>
      </div>
      <div id="animBar">
        <button id="btnPlay">⏸</button>
        <span class="groupLabel">基礎</span>
        <button data-anim="idle" class="on">站立</button>
        <button data-anim="walk">走路</button>
        <button data-anim="run">跑步</button>
        <button data-anim="hurt" class="pose">受擊</button>
        <div class="sep"></div>
        <span class="groupLabel">主武器</span>
        <button data-anim="reload" class="pose">換彈</button>
        <button data-anim="fire_primary" class="pose">射擊</button>
        <div class="sep"></div>
        <span class="groupLabel">副武器</span>
        <button data-anim="switch_secondary" class="pose">切換</button>
        <button data-anim="fire_secondary" class="pose">射擊</button>
        <button id="secPistolBtn" class="sec on">手槍</button>
        <button id="secShotgunBtn" class="sec">霰彈槍</button>
        <div class="sep"></div>
        <span class="groupLabel">近戰</span>
        <button data-anim="switch_melee" class="pose">切換</button>
        <button data-anim="attack_melee" class="pose">攻擊</button>
        <div class="sep"></div>
        <span class="groupLabel">上衣顯示</span>
        <button id="topNormalBtn" class="top on">一般</button>
        <button id="topArmoredBtn" class="top">帶護臂</button>
        <div class="sep"></div>
        <span class="ctxTag" id="ctxTag">受擊顯示：主武器</span>
        <div class="sep"></div>
        <label>速度</label>
        <input type="range" id="speed" min="3" max="24" value="10">
        <span class="val" id="speedVal">10</span>
      </div>
    </section>
    <aside id="right">
      <div class="sec" id="layerDetail">
        <h3><span>選中層微調</span></h3>
        <div id="layerDetailBody"><div class="hint">点左侧卡片或画布色块选中一层。</div></div>
      </div>
      <div class="sec">
        <h3><span>裝備</span><button id="btnAddEq">+ 新增</button></h3>
        <div id="eqList"></div>
      </div>
      <div class="sec" id="eqDetail" style="display:none">
        <h3><span>裝備微調</span></h3>
        <div id="eqDetailBody"></div>
      </div>
    </aside>
  </main>
</div>
<div id="toast"></div>

<script>
"use strict";
const STORAGE_KEY = 'layered_doll_v3';
const CW = 400, CH = 520;

const LAYERS = [
  { id:'backpack',   name:'背包',              group:'extra', z:6,  color:'#2e6a30', pivot:{x:0.5, y:0.4},  def:{x:0.286, y:0.42, w:0.22, h:0.30} },
  { id:'right_leg',  name:'右腿（螢幕左·下）',  group:'extra', z:18, color:'#2a2a2a', pivot:{x:0.5, y:0.05}, def:{x:0.60, y:0.60, w:0.13, h:0.42} },
  { id:'torso',      name:'軀幹',              group:'core',  z:30, color:'#4a6741', pivot:{x:0.5, y:0.10}, def:{x:0.50, y:0.27, w:0.30, h:0.42} },
  { id:'head',       name:'頭（含頭盔）',       group:'core',  z:45, color:'#c89870', pivot:{x:0.5, y:0.92}, def:{x:0.53, y:0.22, w:0.20, h:0.17} },
  { id:'face',       name:'面部',              group:'extra', z:48, color:'#b88860', pivot:{x:0.5, y:0.92}, def:{x:0.57, y:0.23, w:0.14, h:0.13} },
  { id:'left_leg',   name:'左腿（螢幕右·上）',  group:'extra', z:52, color:'#3a3a3a', pivot:{x:0.5, y:0.05}, def:{x:0.44, y:0.62, w:0.14, h:0.44} },
  { id:'back_arm',   name:'後臂（遠側手）',     group:'core',  z:55, color:'#3d3020', pivot:{x:0.5, y:0.5},  def:{x:0.80, y:0.36, w:0.11, h:0.10} },
  { id:'front_arm',  name:'前臂（近側手）',     group:'core',  z:62, color:'#5a4a35', pivot:{x:0.05, y:0.5}, def:{x:0.27, y:0.38, w:0.40, h:0.08} },
];

/* ============================================================
   ★★★ v7.4 修正 ★★★
   1) fire_primary 後坐方向：rot 取負值（手臂向上抬）
   2) fire_secondary 同樣已為負值
   pivot 在矩形左端，canvas 順時針為正：
     rot > 0 → 手 / 槍口 向下
     rot < 0 → 手 / 槍口 向上
   ============================================================ */
const ANIMS = {
  idle: {
    frameCount: 4, fps: 4, loop: true, showEq: 'primary',
    keys: {
      head:      Array(4).fill(0).map((_,i)=>({rot:0,dx:0,dy:[0,-0.5,-0.8,-0.5][i]})),
      torso:     Array(4).fill(0).map((_,i)=>({rot:0,dx:0,dy:[0,-0.5,-0.8,-0.5][i]})),
      back_arm:  Array(4).fill(0).map((_,i)=>({rot:0,dx:0,dy:[0,-0.5,-0.8,-0.5][i]})),
      front_arm: Array(4).fill(0).map((_,i)=>({rot:0,dx:0,dy:[0,-0.5,-0.8,-0.5][i]})),
    }
  },
  walk: {
    frameCount: 8, fps: 10, loop: true, showEq: 'primary',
    keys: {
      head:      Array(8).fill(0).map((_,i)=>({rot:0,dx:0,dy:i%2?-0.5:0})),
      torso:     Array(8).fill(0).map((_,i)=>({rot:0,dx:0,dy:i%2?-0.5:0})),
      back_arm:  Array(8).fill(0).map((_,i)=>({rot:0,dx:0,dy:i%2?-0.5:0})),
      front_arm: Array(8).fill(0).map((_,i)=>({rot:0,dx:0,dy:i%2?-0.5:0})),
      right_leg: [-18,-9,0,9,18,9,0,-9].map(r=>({rot:r,dx:0,dy:0})),
      left_leg:  [18,9,0,-9,-18,-9,0,9].map(r=>({rot:r,dx:0,dy:0})),
    }
  },
  run: {
    frameCount: 8, fps: 16, loop: true, showEq: 'primary',
    keys: {
      head:      Array(8).fill(0).map((_,i)=>({rot:-3,dx:0,dy:i%2?-1.5:-0.5})),
      torso:     Array(8).fill(0).map((_,i)=>({rot:-5,dx:0,dy:i%2?-1.5:-0.5})),
      back_arm:  Array(8).fill(0).map((_,i)=>({rot:-5,dx:0,dy:i%2?-1.5:-0.5})),
      front_arm: Array(8).fill(0).map((_,i)=>({rot:-5,dx:0,dy:i%2?-1.5:-0.5})),
      right_leg: [-42,-22,0,22,42,22,0,-22].map(r=>({rot:r,dx:0,dy:0})),
      left_leg:  [42,22,0,-22,-42,-22,0,22].map(r=>({rot:r,dx:0,dy:0})),
    }
  },
  hurt: {
    frameCount: 4, fps: 8, loop: false, showEq: 'context',
    keys: {
      head:      [{rot:0,dx:0,dy:0},{rot:6,dx:0,dy:-1},{rot:6,dx:0,dy:-1},{rot:0,dx:0,dy:0}],
      torso:     [{rot:0,dx:0,dy:0},{rot:4,dx:0,dy:-1},{rot:4,dx:0,dy:-1},{rot:0,dx:0,dy:0}],
      back_arm:  [{rot:0,dx:0,dy:0},{rot:4,dx:0,dy:-1},{rot:4,dx:0,dy:-1},{rot:0,dx:0,dy:0}],
      front_arm: [{rot:0,dx:0,dy:0},{rot:5,dx:0,dy:-1},{rot:5,dx:0,dy:-1},{rot:0,dx:0,dy:0}],
    }
  },
  /* ★ 修正：fire_primary 後坐時手臂向上抬（rot 取負值） */
  fire_primary: {
    frameCount: 4, fps: 16, loop: false, showEq: 'primary',
    keys: {
      head:      [{rot:0,dx:0,dy:0},{rot:1,dx:0,dy:-1},{rot:0,dx:0,dy:0},{rot:0,dx:0,dy:0}],
      torso:     [{rot:0,dx:0,dy:0},{rot:2,dx:0,dy:-1},{rot:1,dx:0,dy:0},{rot:0,dx:0,dy:0}],
      back_arm:  [{rot:0,dx:0,dy:0},{rot:4,dx:0,dy:-1},{rot:1,dx:0,dy:0},{rot:0,dx:0,dy:0}],
      front_arm: [
        {rot:0,  dx:0,  dy:0},
        {rot:-8, dx:-3, dy:-1},   // 後坐：手臂向上抬
        {rot:-3, dx:-1, dy:0},    // 回落中繼
        {rot:0,  dx:0,  dy:0},
      ],
    }
  },
  reload: {
    frameCount: 10, fps: 10, loop: false, showEq: 'primary',
    keys: {
      head:      Array(10).fill(0).map((_,i)=>{const p=[0,2,3,3,2,1,0,-1,0,0][i];return {rot:0,dx:0,dy:p*0.3};}),
      torso:     Array(10).fill(0).map((_,i)=>{const p=[0,2,3,3,2,1,0,-1,0,0][i];return {rot:0,dx:0,dy:p*0.5};}),
      back_arm:  [0,-15,-30,-35,-25,-10,5,15,5,0].map(r=>({rot:r,dx:0,dy:0})),
      front_arm: [
        {rot:0,  dx:0,  dy:0},
        {rot:-20,dx:-5, dy:1},
        {rot:-40,dx:-8, dy:2},
        {rot:-45,dx:-8, dy:2.5},
        {rot:-30,dx:-5, dy:1.5},
        {rot:-10,dx:-2, dy:0.5},
        {rot:15, dx:5,  dy:-0.5},
        {rot:30, dx:10, dy:-1.5},
        {rot:10, dx:5,  dy:-0.5},
        {rot:0,  dx:0,  dy:0},
      ],
    }
  },
  switch_secondary: {
    frameCount: 8, fps: 10, loop: false, showEq: 'secondary',
    keys: {
      head:      Array(8).fill(0).map((_,i)=>{const p=[0,1,2,2,1,0,-1,-1][i];return {rot:0,dx:0,dy:p*0.3};}),
      torso:     Array(8).fill(0).map((_,i)=>{const p=[0,2,3,3,2,1,0,0][i];return {rot:0,dx:0,dy:p*0.4};}),
      back_arm:  [
        {rot:0,  dx:0,  dy:0},
        {rot:-8, dx:-2, dy:0},
        {rot:-15,dx:-4, dy:0},
        {rot:-12,dx:-3, dy:0},
        {rot:-8, dx:-2, dy:0},
        {rot:-4, dx:-1, dy:0},
        {rot:0,  dx:0,  dy:0},
        {rot:0,  dx:0,  dy:0},
      ],
      front_arm: [
        {rot:0,  dx:0,   dy:0},
        {rot:-15,dx:-3,  dy:1},
        {rot:-25,dx:-5,  dy:2},
        {rot:-15,dx:-3,  dy:1.5},
        {rot:-5, dx:-1,  dy:0.5},
        {rot:0,  dx:0,   dy:-0.5},
        {rot:3,  dx:0,   dy:-1},
        {rot:3,  dx:0,   dy:-1},
      ],
    }
  },
  /* ★ 後坐：手臂向上抬（rot 取負值） */
  fire_secondary: {
    frameCount: 4, fps: 14, loop: false, showEq: 'secondary',
    keys: {
      head:      Array(4).fill({rot:0,dx:0,dy:0}),
      torso:     Array(4).fill({rot:0,dx:0,dy:0}),
      back_arm:  Array(4).fill({rot:0,dx:0,dy:0}),
      front_arm: [
        {rot:3,   dx:0,   dy:-1},
        {rot:-12, dx:-1,  dy:-3},
        {rot:-4,  dx:0,   dy:-1.8},
        {rot:3,   dx:0,   dy:-1},
      ],
    }
  },
  switch_melee: {
    frameCount: 8, fps: 10, loop: false, showEq: 'melee',
    keys: {
      head:      Array(8).fill(0).map((_,i)=>{const p=[0,1,2,2,1,0,-1,-1][i];return {rot:0,dx:0,dy:p*0.3};}),
      torso:     Array(8).fill(0).map((_,i)=>{const p=[0,2,3,3,2,1,0,0][i];return {rot:0,dx:0,dy:p*0.4};}),
      back_arm:  [0,-8,-15,-15,-10,-5,5,10].map(r=>({rot:r,dx:0,dy:0})),
      front_arm: [
        {rot:0,  dx:0,  dy:0},
        {rot:-15,dx:-3, dy:1},
        {rot:-25,dx:-5, dy:2},
        {rot:-10,dx:-2, dy:1.5},
        {rot:10, dx:0,  dy:0.5},
        {rot:20, dx:2,  dy:0},
        {rot:15, dx:2,  dy:-1},
        {rot:10, dx:1,  dy:-1},
      ],
    }
  },
  attack_melee: {
    frameCount: 8, fps: 14, loop: false, showEq: 'melee',
    keys: {
      head:      [{rot:0,dx:0,dy:0},{rot:-2,dx:0,dy:0},{rot:-3,dx:0,dy:0},{rot:0,dx:0,dy:0},{rot:3,dx:0,dy:0},{rot:2,dx:0,dy:0},{rot:1,dx:0,dy:0},{rot:0,dx:0,dy:0}],
      torso:     [{rot:0,dx:0,dy:0},{rot:-3,dx:-1,dy:0},{rot:-6,dx:-2,dy:0},{rot:0,dx:0,dy:0},{rot:6,dx:2,dy:0},{rot:3,dx:1,dy:0},{rot:1,dx:0,dy:0},{rot:0,dx:0,dy:0}],
      back_arm:  [10,-10,-25,-10,15,5,5,10].map(r=>({rot:r,dx:0,dy:0})),
      front_arm: [
        {rot:10, dx:1,  dy:-1},
        {rot:-15,dx:-2, dy:-1},
        {rot:-40,dx:-5, dy:-2},
        {rot:0,  dx:0,  dy:-1},
        {rot:60, dx:10, dy:0},
        {rot:100,dx:15, dy:1},
        {rot:60, dx:8,  dy:0},
        {rot:10, dx:1,  dy:-1},
      ],
    }
  },
};

const EQ_TYPE_TO_LAYER = {
